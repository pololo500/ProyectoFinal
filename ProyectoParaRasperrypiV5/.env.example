# API Key de Groq (gratis en https://console.groq.com)
# Solo necesaria si se usa el modo "Nube"
GROQ_API_KEY=gsk_tu_api_key_aqui

# Tamaño del modelo Whisper local (tiny | base | small | medium | large-v3).
# Default en código: small (rápido en CPU). medium es más preciso pero ~20s/frase.
WHISPER_MODEL=small
